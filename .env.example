# Your tools (jsa-mcp container and local CLI)
ANTHROPIC_API_KEY=
JSA_PARSE_MODEL=claude-haiku-5-5
JSA_MATCH_MODEL=claude-sonnet-5-5
JSA_DOCS_DIR=data/my_docs
JSA_DB_PATH=data/db/jsa.sqlite

# MCP server (src/jsa/mcp_server.py). Defaults suit local use; Docker sets
# JSA_MCP_HOST=0.0.0.0 and JSA_MCP_ALLOWED_HOSTS=jsa-mcp:8000.
JSA_MCP_HOST=127.0.0.1
JSA_MCP_PORT=8000
JSA_MCP_ALLOWED_HOSTS=
